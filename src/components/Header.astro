---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
import "@fontsource-variable/josefin-sans";
import { Icon } from "astro-icon/components";
---

<header>
  <nav
    class="font-display fixed top-0 z-10 flex w-full items-start justify-between bg-zinc-100 p-4 dark:bg-zinc-900"
  >
    <div class="flex w-1/5 justify-start">
      <a
        href="/"
        class="group hidden flex-row items-center justify-center gap-2 text-rose-700 duration-300 ease-in hover:text-rose-600 active:text-rose-500 active:duration-100 md:flex"
      >
        <h3
          class="tracking-tighter duration-300 ease-in-out group-hover:tracking-normal group-active:tracking-widest group-active:duration-100"
        >
          {SITE_TITLE}
        </h3>
      </a>
      <a
        href="/"
        class="block text-xl text-rose-700 duration-300 ease-in hover:scale-105 hover:text-rose-600 active:scale-120 active:text-rose-500 active:duration-100 md:hidden"
      >
        <p class="sr-only">Home</p>
        <img
          src="/favicon.svg"
          alt="Echoes"
          width={40}
          height={40}
          loading="eager"
          class="h-6 w-6"
        />
      </a>
    </div>
    <div class="flex flex-1 justify-center gap-4">
      <HeaderLink href="/series">Series</HeaderLink>
      <HeaderLink href="/one-shots">One Shots</HeaderLink>
    </div>
    <div class="flex w-1/5 flex-row justify-end gap-2">
      <a
        href="/search"
        class="group text-xl text-rose-700 duration-300 ease-in-out hover:scale-105 hover:text-rose-600 active:scale-120 active:text-rose-500 active:duration-100"
      >
        <p class="sr-only">Search</p>
        <Icon
          name="mdi:search"
          class="h-6 w-6 duration-300 ease-in-out group-hover:scale-105 group-active:scale-120 group-active:duration-100"
        />
      </a>
    </div>
  </nav>
</header>
