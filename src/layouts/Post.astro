---
import SanityImage from "@/components/SanityImage.astro";
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";
import type { SanityDocument } from "@sanity/client";

const { title, mainImage, previousPost, nextPost, relatedPosts } = Astro.props;
---

<Layout>
  <article
    class="flex w-full flex-col items-center justify-center rounded-xl bg-zinc-100 dark:bg-zinc-900"
  >
    {
      mainImage && (
        <SanityImage
          src={mainImage}
          alt={title}
          width={1000}
          height={250}
          className="rounded-xl w-full"
        />
      )
    }
    <div
      class="flex w-full flex-col gap-2 py-4 text-justify leading-relaxed tracking-tight lg:w-1/2"
    >
      <div class="flex flex-col items-center justify-center">
        <h1>{title}</h1>
      </div>
      <slot />
    </div>
    {
      previousPost || nextPost ? (
        <div class="relative mt-8 flex h-16 w-full items-center justify-between lg:w-1/3">
          {previousPost && (
            <a
              href={`${previousPost.slug.current}`}
              class="absolute top-0 bottom-0 left-0 flex w-[45%] items-center justify-center gap-2 self-end border-b-2 border-emerald-300 p-2 tracking-tight duration-300 ease-in-out hover:scale-x-105 hover:border-emerald-400 hover:tracking-normal active:scale-120 active:duration-100 md:w-52 md:p-4"
            >
              <Icon name="mdi:chevron-left" class="h-6 w-6" />
              <div class="line-clamp-2 w-28">
                <p class="text-sm text-zinc-500">Previous Chapter</p>
                <p>{previousPost.title}</p>
              </div>
            </a>
          )}
          {nextPost && (
            <a
              href={`${nextPost.slug.current}`}
              class="absolute top-0 right-0 bottom-0 flex w-[45%] items-center justify-center gap-2 self-end border-b-2 border-emerald-300 p-2 tracking-tight duration-300 ease-in-out hover:scale-x-105 hover:border-emerald-400 hover:tracking-normal active:scale-120 active:duration-100 md:w-52 md:p-4"
            >
              <div class="line-clamp-2 w-28">
                <p class="text-sm text-zinc-500">Next Chapter</p>
                <p>{nextPost.title}</p>
              </div>
              <Icon name="mdi:chevron-right" class="h-6 w-6" />
            </a>
          )}
        </div>
      ) : (
        relatedPosts && (
          <div class="relative mt-8 flex h-16 w-full flex-col items-center justify-between gap-2">
            <h2 class="text-xl font-bold">Related Posts</h2>
            <div class="flex w-full flex-wrap items-center justify-center gap-4">
              {relatedPosts.map((post: SanityDocument) => (
                <a
                  href={`/${post.category.title === "One Shot" ? `one-shots/${post.slug.current}` : `series/${post.series.slug.current}/${post.slug.current}`}`}
                  class="flex w-36 flex-col items-center justify-center gap-2 self-end border-b-2 border-emerald-300 p-2 tracking-tight duration-300 ease-in-out hover:scale-x-105 hover:border-emerald-400 hover:tracking-normal active:scale-120 active:duration-100 md:w-52 md:p-4"
                >
                  <div class="flex w-full flex-col gap-1 text-center">
                    <p class="text-sm font-bold">{post.title}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      )
    }
  </article>
</Layout>
